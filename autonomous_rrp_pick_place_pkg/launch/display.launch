<launch>
  <!-- Load URDF model into ROS parameter server -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find autonomous_rrp_pick_place_pkg)/urdf/rrp_arm.urdf.xacro'" />

  <!-- GUI for manually controlling Revolute and Prismatic joints -->
  <!--<node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />-->
  <!--<node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />-->

  <!-- Robot State Publisher to compute and broadcast link transforms -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <!-- Launch RViz -->
  <node name="rviz" pkg="rviz" type="rviz" required="true" />
</launch>
